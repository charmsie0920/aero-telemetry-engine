{
  "uid": "aero-pipeline",
  "title": "Aero Telemetry Pipeline",
  "description": "Near-real-time OpenSky ingestion: live map and pipeline health.",
  "tags": [
    "aero"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Aircraft now",
      "description": "Distinct aircraft with a position in the last 2 minutes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(DISTINCT icao24) AS aircraft\nFROM telemetry.state_vectors\nWHERE observed_at > now() - interval '2 minutes'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last good poll",
      "description": "Seconds since the last successful OpenSky poll. Polls run every 30 s; /health/ready fails after 120 s.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(started_at)) AS seconds_ago\nFROM telemetry.ingestion_runs\nWHERE error IS NULL"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed polls (1 h)",
      "description": "Polls that ended in an error after retries (timeouts, 5xx, 429, open circuit).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS failed\nFROM telemetry.ingestion_runs\nWHERE error IS NOT NULL AND started_at > now() - interval '1 hour'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "OpenSky credits left",
      "description": "X-Rate-Limit-Remaining from the last poll. 4,000 per day; 30 s polling uses 2,880.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT credits_remaining\nFROM telemetry.ingestion_runs\nWHERE credits_remaining IS NOT NULL\nORDER BY started_at DESC\nLIMIT 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "green",
                "value": 1500
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Rows stored",
      "description": "Rows in the hot table. Partitions older than 48 h are detached by pg_partman.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS rows FROM telemetry.state_vectors"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Database size",
      "description": "Supabase's free tier rejects writes above 500 MB; the budget is 350 MB (PRD 7.2).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT pg_database_size(current_database()) AS size"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 350000000
              },
              {
                "color": "red",
                "value": 450000000
              }
            ]
          },
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "geomap",
      "title": "Live aircraft (last 2 minutes)",
      "description": "Latest position of each airborne aircraft. Colour = barometric altitude; the icon points along the track.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (icao24)\n  icao24,\n  coalesce(callsign, icao24) AS callsign,\n  latitude,\n  longitude,\n  baro_altitude_m AS altitude_m,\n  round((velocity_ms * 3.6)::numeric) AS speed_kmh,\n  coalesce(true_track_deg, 0) AS true_track_deg,\n  observed_at\nFROM telemetry.state_vectors\nWHERE observed_at > now() - interval '2 minutes'\n  AND NOT on_ground\nORDER BY icao24, observed_at DESC"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 50.5,
          "lon": 4.5,
          "zoom": 6.3,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap",
          "config": {}
        },
        "layers": [
          {
            "type": "markers",
            "name": "Aircraft",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "fixed": 12
                },
                "color": {
                  "field": "altitude_m",
                  "fixed": "dark-green"
                },
                "opacity": 0.9,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/plane.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "rotation": {
                  "field": "true_track_deg",
                  "fixed": 0,
                  "mode": "mod",
                  "min": -360,
                  "max": 360
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "min": 0,
          "max": 12000,
          "unit": "lengthm"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rows per poll",
      "description": "What happened to each poll's records. Duplicates are skipped by ON CONFLICT DO NOTHING.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  started_at AS \"time\",\n  records_inserted AS \"new rows\",\n  records_duplicate AS \"duplicates (stale positions)\",\n  records_received - records_valid AS \"rejected by validation\"\nFROM telemetry.ingestion_runs\nWHERE $__timeFilter(started_at)\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Polls per minute",
      "description": "Expect 2 per minute. A gap means the worker was not running.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(started_at, '1m'),\n  count(*) FILTER (WHERE error IS NULL) AS \"ok\",\n  count(*) FILTER (WHERE error IS NOT NULL) AS \"failed\"\nFROM telemetry.ingestion_runs\nWHERE $__timeFilter(started_at)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Aircraft tracked (per 5 min)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(observed_at, '5m'),\n  count(DISTINCT icao24) AS \"aircraft\"\nFROM telemetry.state_vectors\nWHERE $__timeFilter(observed_at)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Poll duration",
      "description": "OpenSky call including retries and backoff. Attempts time out at 10 s.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  started_at AS \"time\",\n  duration_ms AS \"poll duration\"\nFROM telemetry.ingestion_runs\nWHERE $__timeFilter(started_at)\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "OpenSky credits left",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  started_at AS \"time\",\n  credits_remaining AS \"credits left\"\nFROM telemetry.ingestion_runs\nWHERE $__timeFilter(started_at) AND credits_remaining IS NOT NULL\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Recent failed polls",
      "description": "Failures are recorded, not just logged: every poll gets an ingestion_runs row.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aero-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aero-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  started_at AS \"time\",\n  http_status,\n  retries,\n  duration_ms,\n  error\nFROM telemetry.ingestion_runs\nWHERE error IS NOT NULL AND $__timeFilter(started_at)\nORDER BY started_at DESC\nLIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
