# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Never put a real secret in here.

# ---------------------------------------------------------------------------
# OpenSky Network (OAuth2 client credentials)
# Create an API client under your OpenSky account to get these. Basic
# username/password auth was removed in March 2026.
# ---------------------------------------------------------------------------
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Bounding box: 5 deg x 5 deg = 25 sq deg -> 1 OpenSky credit per call.
# 2880 calls/day at 30s polling, inside the 4000/day budget (PRD D3).
# Default below covers Benelux / NW Europe (densest OpenSky coverage).
# KEEP the area at or under 25 sq deg: above that OpenSky charges 2-4 credits
# per call and the daily budget runs out mid-day.
OPENSKY_BBOX_LAMIN=48.0
OPENSKY_BBOX_LOMIN=2.0
OPENSKY_BBOX_LAMAX=53.0
OPENSKY_BBOX_LOMAX=7.0
OPENSKY_POLL_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# Supabase Postgres (production target)
# Use the SESSION-mode pooler string from the Supabase dashboard
# (Connect -> Session pooler). The direct db.<ref>.supabase.co host is
# IPv6-only and unreachable from IPv4-only networks and EC2 VPCs. Transaction
# mode breaks DbUp's advisory lock and the worker's long-lived connection.
# ---------------------------------------------------------------------------
POSTGRES_CONNECTION_STRING=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Local development Postgres (docker-compose.yml)
# LOCAL_* is deliberately separate so the Supabase values above can never leak
# into the dev container. These defaults match docker-compose.yml.
# ---------------------------------------------------------------------------
LOCAL_POSTGRES_DB=aero
LOCAL_POSTGRES_USER=aero
LOCAL_POSTGRES_PASSWORD=aero
LOCAL_POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=aero;Username=aero;Password=aero

# ---------------------------------------------------------------------------
# AWS (Phase 2+)
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_S3_ARCHIVE_BUCKET=
AWS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Inference service (Phase 3)
# ---------------------------------------------------------------------------
INFERENCE_API_KEY=
MODEL_VERSION=

# ---------------------------------------------------------------------------
# Grafana (Phase 2)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
