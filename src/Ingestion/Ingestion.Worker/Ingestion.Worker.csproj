<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Sdk.Web (not Sdk.Worker) for the /health endpoints. Hosting, HttpClient
       factory, options validation and health checks all come with the
       ASP.NET Core shared framework, so they need no package references. -->

  <PropertyGroup>
    <UserSecretsId>dotnet-Ingestion.Worker-9deb3bcd-1872-422e-b6b4-4a98a750379a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ingestion.Core\Ingestion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>
</Project>
