# Normalise everything to LF in the repository. Without this, Windows commits
# CRLF into .sql and .sh files, which breaks shell entrypoints inside Linux
# containers ("bad interpreter") and makes diffs noisy across machines.
* text=auto eol=lf

# Visual Studio rewrites these with CRLF on every save; let it.
*.sln       text eol=crlf
*.csproj    text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Never touch these.
*.png       binary
*.jpg       binary
*.ico       binary
*.onnx      binary
*.pt        binary
*.pth       binary
*.parquet   binary
