      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1018,
      "y": 172,
      "width": 416.624,
      "height": 100,
      "text": "Services 1, 3, 4, 5: Docker Compose on one AWS EC2\nDatabase: hosted by Supabase, not on the server,\nso the server holds no data and can be rebuilt\nTerraform: creates the AWS side (EC2, S3, IAM)\nGitHub Actions: build, test, scan, deploy",
      "originalText": "Services 1, 3, 4, 5: Docker Compose on one AWS EC2\nDatabase: hosted by Supabase, not on the server,\nso the server holds no data and can be rebuilt\nTerraform: creates the AWS side (EC2, S3, IAM)\nGitHub Actions: build, test, scan, deploy",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
