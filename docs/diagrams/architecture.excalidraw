      "link": null,
      "locked": false,
      "type": "text",
      "x": 58,
      "y": 172,
      "width": 435.984,
      "height": 60,
      "text": "The Collector and the Detector never call each other.\nThey only share the database, so if the ML side\ncrashes, data collection carries on.",
      "originalText": "The Collector and the Detector never call each other.\nThey only share the database, so if the ML side\ncrashes, data collection carries on.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
